{
  "info": {
    "name": "Project CSR API",
    "description": "Collection API untuk Project CSR (Auth, JWT, RBAC, dan Endpoints)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('Token updated automatically from Register!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Ahmad Dani\",\n  \"email\": \"ahmad.dani@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/register",
              "host": ["{{base_url}}"],
              "path": ["api", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('Token updated automatically from Login!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ahmad.dani@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": ["{{base_url}}"],
              "path": ["api", "login"]
            }
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Companies",
      "item": [
        {
          "name": "Create Company (Onboarding -> MANAGEMENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('Token updated with MANAGEMENT role!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"PT Sumber Energi Hijau\",\n  \"description\": \"Perusahaan energi terbarukan yang fokus pada reboisasi dan lingkungan.\",\n  \"email\": \"csr@sumberenergi.co.id\",\n  \"phone\": \"+6281234567890\",\n  \"address\": \"Jl. Jenderal Sudirman Kav. 52-53\",\n  \"city\": \"Jakarta Selatan\",\n  \"province\": \"DKI Jakarta\",\n  \"website\": \"https://sumberenergi.co.id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/companies",
              "host": ["{{base_url}}"],
              "path": ["api", "companies"]
            }
          }
        },
        {
          "name": "Get My Company",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/companies/current",
              "host": ["{{base_url}}"],
              "path": ["api", "companies", "current"]
            }
          }
        },
        {
          "name": "List Companies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/companies?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "companies"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Partners",
      "item": [
        {
          "name": "Create Partner (Onboarding -> PARTNER_ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('token', res.data.accessToken);",
                  "    console.log('Token updated with PARTNER_ADMIN role!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yayasan Lindungi Hutan\",\n  \"description\": \"Lembaga konservasi hutan dan penanaman mangrove di pesisir Indonesia.\",\n  \"email\": \"kontak@lindungi-hutan.org\",\n  \"phone\": \"+628987654321\",\n  \"address\": \"Jl. Hutan Lestari No. 12\",\n  \"city\": \"Semarang\",\n  \"province\": \"Jawa Tengah\",\n  \"website\": \"https://lindungi-hutan.org\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/partners",
              "host": ["{{base_url}}"],
              "path": ["api", "partners"]
            }
          }
        },
        {
          "name": "Get My Partner",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/partners/current",
              "host": ["{{base_url}}"],
              "path": ["api", "partners", "current"]
            }
          }
        },
        {
          "name": "List Partners",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/partners?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "partners"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Tests & RBAC",
      "item": [
        {
          "name": "Test Protected Route (CSR_ADMIN Only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/test",
              "host": ["{{base_url}}"],
              "path": ["api", "test"]
            }
          }
        }
      ]
    }
  ]
}
